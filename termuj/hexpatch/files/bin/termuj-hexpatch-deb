#!/data/data/com.termuj/files/usr/bin/sh
# Hexpatch .deb packages built for the official Termux app so that they can be
# installed by the "com.termuj" app. As both package names have the same
# length, every occurrence is replaced in-place (binaries included). The
# content of compressed archives (zip/apk/jar, gzip, xz, bzip2) is patched too
# and checksums are fixed up, by the TermujHexpatch helper (run by app_process).
# See https://github.com/termux/termux-app/issues/2734#issuecomment-1747413134
#
# Called by apt via "DPkg::Pre-Install-Pkgs" (deb paths on stdin) before dpkg
# unpacks the packages, or manually: termuj-hexpatch-deb <file.deb>...

set -e

# Split so that this script itself is never matched by a hexpatch.
OLD="com.termu""x"
OLD_RE="com\\.termu""x"
NEW="com.termuj"
PREFIX="/data/data/$NEW/files/usr"
HELPER="$PREFIX/libexec/termuj-hexpatch.jar"
export LC_ALL=C

# Create an ar archive like "ar cr" does, as binutils is not part of the bootstrap.
ar_create() {
	out="$1"
	shift
	printf '!<arch>\n' > "$out"
	for f in "$@"; do
		size="$(stat -c %s "$f")"
		printf '%-16s%-12s%-6s%-6s%-8s%-10s`\n' "$(basename "$f")" 0 0 0 100644 "$size" >> "$out"
		cat "$f" >> "$out"
		[ $((size % 2)) -eq 0 ] || printf '\n' >> "$out"
	done
}

# Pack a directory like termux-packages does (termux_step_create_debian_package).
tar_create() {
	(cd "$1" && tar --sort=name --owner=0 --group=0 --numeric-owner -H gnu -cf - .) | gzip -1 > "$2"
}

# Patch the files whose NUL separated paths are on stdin, print the number of changed files.
hexpatch_files() {
	# Android 14 refuses to load writable dex files.
	if [ -w "$HELPER" ]; then
		chmod 0400 "$HELPER"
	fi
	(
		unset LD_LIBRARY_PATH LD_PRELOAD
		# For the scratch files of the helper.
		export TMPDIR="$PREFIX/tmp"
		CLASSPATH="$HELPER" exec /system/bin/app_process -Xnoimage-dex2oat / TermujHexpatch
	)
}

patch_deb() {
	deb="$1"
	tmp="$(mktemp -d "$PREFIX/tmp/termuj-hexpatch.XXXXXX")"
	ctrl="$tmp/control"
	data="$tmp/data"
	mkdir "$ctrl" "$data"

	dpkg-deb --ctrl-tarfile "$deb" | tar -xpf - -C "$ctrl"
	dpkg-deb --fsys-tarfile "$deb" | tar -xpf - -C "$data"

	# File contents
	changed="$(find "$ctrl" "$data" -type f -print0 | hexpatch_files)"

	if [ "$changed" = 0 ] && [ -z "$(find "$data" -name "*$OLD*" -print -quit)" ] && \
		[ -z "$(find "$data" -type l -lname "*$OLD*" -print -quit)" ]; then
		rm -rf "$tmp"
		tmp=""
		return 0
	fi

	echo "termuj-hexpatch: patching $(basename "$deb")"

	# Symlink targets
	find "$data" -type l -lname "*$OLD*" | while IFS= read -r link; do
		target="$(readlink "$link" | sed "s/$OLD_RE/$NEW/g")"
		ln -sfn "$target" "$link"
	done

	# File and directory names (deepest first)
	find "$data" -depth -name "*$OLD*" | while IFS= read -r path; do
		dir="$(dirname "$path")"
		name="$(basename "$path" | sed "s/$OLD_RE/$NEW/g")"
		if [ -e "$dir/$name" ] && [ -d "$path" ]; then
			cp -a "$path/." "$dir/$name/"
			rm -rf "$path"
		else
			mv "$path" "$dir/$name"
		fi
	done

	# Recompute the hashes of the files listed in md5sums, keeping the list unchanged
	if [ -f "$ctrl/md5sums" ]; then
		if ! (cd "$data" && sed 's/^[0-9a-f]*  //' "$ctrl/md5sums" | xargs -r -d '\n' md5sum) > "$tmp/md5sums"; then
			echo "termuj-hexpatch: failed to recompute md5sums of $(basename "$deb"), aborting" >&2
			exit 1
		fi
		mv "$tmp/md5sums" "$ctrl/md5sums"
	fi

	printf '2.0\n' > "$tmp/debian-binary"
	tar_create "$ctrl" "$tmp/control.tar.gz"
	tar_create "$data" "$tmp/data.tar.gz"
	ar_create "$tmp/patched.deb" "$tmp/debian-binary" "$tmp/control.tar.gz" "$tmp/data.tar.gz"
	mv "$tmp/patched.deb" "$deb"
	rm -rf "$tmp"
	tmp=""
}

tmp=""
trap '[ -n "$tmp" ] && rm -rf "$tmp"' EXIT

if [ "$1" = "--apt" ]; then
	while IFS= read -r line; do
		case "$line" in
			*.deb) [ -f "$line" ] && patch_deb "$line" ;;
		esac
	done
else
	for deb in "$@"; do
		patch_deb "$deb"
	done
fi
